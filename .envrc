# direnv: create/sync and activate the uv-managed venv, and point Quarto at it.
# Run `direnv allow` after any edit to this file.

# Re-evaluate when dependencies change, so the venv stays in sync with uv.lock.
watch_file pyproject.toml uv.lock .python-version

if [[ ! -d .venv ]] || [[ uv.lock -nt .venv ]]; then
  uv sync --quiet
  touch .venv
fi

source .venv/bin/activate

# Any Python code cells Quarto runs use this project's venv, not the system Python.
export QUARTO_PYTHON="$PWD/.venv/bin/python"
